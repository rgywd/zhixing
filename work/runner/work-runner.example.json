{
  "id": "minecraft",
  "name": "Minecraft",
  "version": "1.0.0",
  "coreUrl": "https://work.example.com",
  "token": "replace-with-runner-token",
  "stateFile": "./data/runner-state.json",
  "codexHome": "C:/Users/you/.zhixing-work/codex-home",
  "pollIntervalMs": 2000,
  "catalogRefreshIntervalMs": 30000,
  "defaultRuntimes": [
    {
      "id": "codex",
      "name": "Codex",
      "command": "codex",
      "models": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna", "gpt-5.3-codex-spark"],
      "reasoningEfforts": ["low", "medium", "high", "xhigh", "max"],
      "reasoningEffortsByModel": {
        "gpt-5.3-codex-spark": ["low", "medium", "high", "xhigh"]
      }
    },
    {
      "id": "claude-code",
      "name": "Claude Code",
      "command": "claude",
      "models": ["sonnet", "opus"],
      "reasoningEfforts": ["medium", "high", "xhigh", "max"]
    }
  ],
  "repoRoots": [
    {
      "id": "workspace",
      "name": "Workspace",
      "path": "D:/workspace",
      "strategy": "children"
    },
    {
      "id": "documents",
      "name": "Documents",
      "path": "%USERPROFILE%/Documents",
      "strategy": "projects",
      "maxDepth": 3
    }
  ],
  "repos": [
    {
      "id": "zhixing",
      "name": "zhixing",
      "path": "C:/Users/you/Documents/zhixing/zhixing-rikkahub"
    }
  ]
}

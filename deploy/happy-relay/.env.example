# 对外 HTTPS origin；必须与知行 App 和 zhixing-agent 中配置的地址一致。
HAPPY_PUBLIC_URL=https://happy.example.com

# 生成方式：openssl rand -hex 32
# 首次部署后必须稳定保存；不要提交到 Git，也不要与模型 API key 复用。
HANDY_MASTER_SECRET=replace-with-a-random-64-char-hex-secret

# 默认仅暴露给本机反向代理。
HAPPY_BIND_ADDRESS=127.0.0.1
HAPPY_BIND_PORT=3005

# 仅在启用 bundled-proxy profile 时使用。
HAPPY_DOMAIN=happy.example.com

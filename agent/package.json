{
  "name": "zhixing-agent",
  "version": "0.3.0",
  "description": "知行开发机守护：旁路保留 Wire，并管理 Codex App Server direct 连接",
  "license": "MIT",
  "type": "module",
  "bin": {
    "zhixing-agent": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "smoke:p2": "npm run build && node dist/p2Smoke.js",
    "smoke:p4": "npm run build && node dist/p4Smoke.js",
    "smoke:p5": "npm run build && node dist/p5Smoke.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.214",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "socket.io-client": "^4.8.1",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

log_format privacy '[$time_local] "$request_method $uri $server_protocol" '
                   '$status $body_bytes_sent';

limit_req_zone $server_name zone=search_per_minute:10m rate=${SEARXNG_RATE_PER_MINUTE}r/m;
limit_conn_zone $server_name zone=search_concurrent:10m;

upstream searxng_core {
    server core:8080;
    keepalive 8;
}

server {
    listen 8443 ssl;
    server_name ${SEARXNG_DOMAIN};
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${SEARXNG_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SEARXNG_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    access_log /var/log/nginx/access.log privacy;
    error_log /var/log/nginx/error.log warn;

    client_max_body_size 1k;
    limit_req_status 429;
    limit_conn_status 429;

    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Referrer-Policy "no-referrer" always;

    location = /healthz {
        access_log off;
        proxy_pass http://searxng_core/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    location = /search {
        auth_basic "Zhixing SearXNG";
        auth_basic_user_file /etc/nginx/auth/htpasswd;

        limit_except GET {
            deny all;
        }

        limit_req zone=search_per_minute burst=${SEARXNG_BURST} nodelay;
        limit_conn search_concurrent ${SEARXNG_MAX_CONCURRENT};

        proxy_pass http://searxng_core;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}
